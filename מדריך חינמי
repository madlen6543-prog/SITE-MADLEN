            <div class="text-center space-y-2.5">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-purple-600 to-fuchsia-600 flex items-center justify-center mx-auto shadow-md shadow-fuchsia-600/30 border border-fuchsia-300/30 text-lg text-white">
                    <i class="fa-solid fa-sparkles"></i>
