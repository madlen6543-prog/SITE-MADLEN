            </div>

            <!-- FORM WITH ORIGINAL CLEAN LABELS AND PADDING -->
            <form id="gateForm" onsubmit="return window.handleGateSubmit(event)" class="space-y-3.5 pt-0.5 relative z-10">
                <div>
                    <label for="leadName" class="block text-xs font-bold text-purple-200 mb-1">שם מלא</label>
                    <div class="relative">
                        <input type="text" id="leadName" required placeholder="איך קוראים לך?" 
                            class="w-full bg-galaxy-950/90 border border-purple-500/40 focus:border-fuchsia-400 rounded-xl pr-11 pl-4 py-3 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-500/40 transition-all shadow-inner">
                        <i class="fa-solid fa-user absolute right-3.5 top-3.5 text-purple-300/80 text-xs sm:text-sm"></i>
                    </div>
                </div>

                <div>
                    <label for="leadEmail" class="block text-xs font-bold text-purple-200 mb-1">כתובת מייל</label>
                    <div class="relative">
                        <input type="email" id="leadEmail" required placeholder="yourname@gmail.com" 
                            class="w-full bg-galaxy-950/90 border border-purple-500/40 focus:border-fuchsia-400 rounded-xl pr-11 pl-4 py-3 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-500/40 transition-all text-left dir-ltr shadow-inner">
                        <i class="fa-solid fa-envelope absolute right-3.5 top-3.5 text-purple-300/80 text-xs sm:text-sm"></i>
                    </div>
                </div>

                <div>
                    <label for="leadPhone" class="block text-xs font-bold text-purple-200 mb-1">מספר טלפון</label>
                    <div class="relative">
                        <input type="tel" id="leadPhone" required placeholder="050-0000000" 
                            class="w-full bg-galaxy-950/90 border border-purple-500/40 focus:border-fuchsia-400 rounded-xl pr-11 pl-4 py-3 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-500/40 transition-all text-left dir-ltr shadow-inner">
                        <i class="fa-solid fa-phone absolute right-3.5 top-3.5 text-purple-300/80 text-xs sm:text-sm"></i>
                    </div>
                </div>

                <div>
                    <label for="leadPain" class="block text-xs font-bold text-purple-200 mb-1">מה הדבר שהכי מציק לך כרגע והיית רוצה לפתור?</label>
                    <textarea id="leadPain" required rows="2" placeholder="למשל: נלחץ/ת באינטראקציות חברתיות, קשה לפתח שיחה עם אנשים חדשים, לא מצליח/ה להגיד מה שאני חושב/ת..." 
                        class="w-full bg-galaxy-950/90 border border-purple-500/40 focus:border-fuchsia-400 rounded-xl px-3.5 py-2.5 text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-500/40 transition-all resize-none leading-relaxed shadow-inner"></textarea>
                </div>

                <button type="submit" 
                    class="w-full py-3.5 sm:py-4 px-5 btn-galaxy text-white font-heading font-extrabold text-base sm:text-lg rounded-xl cursor-pointer mt-2 border border-fuchsia-300/30 flex items-center justify-center gap-2">
                    <span>אני רוצה גישה למדריך!</span>
                    <i class="fa-solid fa-sparkles text-fuchsia-200 text-sm"></i>
                </button>

                <p class="text-[11px] text-center text-purple-200/90 pt-0.5 flex items-center justify-center gap-1.5 font-medium">
                    <i class="fa-solid fa-shield-halved text-fuchsia-300"></i>
                    <span>הפרטים שלך מאובטחים לחלוטין ונשמרים אצלי בלבד</span>
                </p>
            </form>
        </div>
    </div>

    <!-- MAIN PAGE HEADER -->
    <header class="relative z-10 pt-8 sm:pt-12 pb-4 sm:pb-6 px-4 text-center max-w-4xl mx-auto space-y-3.5">
        <h1 class="font-heading font-black text-xl sm:text-3xl md:text-4xl text-white leading-snug sm:leading-tight glow-text px-1">
            איך להפסיק להתבייש – <br class="hidden sm:inline">ולהתחיל <span class="text-fuchsia-300 font-extrabold">להתבטא יותר באותנטיות ושחרור</span> מול אנשים
        </h1>
        
        <div id="personalizedWelcome" class="hidden my-3 p-3.5 sm:p-4 rounded-xl bg-galaxy-900/95 border border-fuchsia-500/40 max-w-lg mx-auto shadow-lg glow-deep-purple">
            <p class="text-purple-100 font-bold text-xs sm:text-base leading-relaxed">
                ✨ היי <span id="userNameDisplay" class="font-extrabold text-fuchsia-200 underline decoration-fuchsia-400"></span>, איזה כיף לראות אותך כאן!<br>
                המדריך מחכה לך ממש למטה:
            </p>
        </div>
    </header>

    <main class="relative z-10 max-w-4xl mx-auto px-3.5 sm:px-4 py-2 space-y-8 sm:space-y-10">
        
        <!-- VIDEO SECTION -->
        <section id="videoSection" class="glass-card rounded-2xl sm:rounded-3xl p-4 sm:p-7 glow-deep-purple border border-purple-500/40 space-y-5">
            <div class="flex items-center justify-between px-0.5">
                <div class="flex items-center gap-2 text-purple-100 font-bold text-xs sm:text-base">
                    <i class="fa-solid fa-circle-play text-fuchsia-300 text-lg sm:text-xl"></i>
                    <span>4 צעדים שלב אחר שלב להתגבר על ביישנות ולהבין איך לבנות יותר ביטחון</span>
                </div>
            </div>

            <!-- YouTube Video Container with Smart Preview Launcher -->
            <div id="videoContainer" class="relative w-full aspect-video rounded-xl sm:rounded-2xl overflow-hidden bg-galaxy-950 border border-purple-600/40 shadow-2xl group cursor-pointer">
                
                <!-- High quality YouTube Cover Overlay -->
                <div id="videoCover" onclick="playVideoAction()" class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-cover bg-center transition-all duration-300" style="background-image: url('https://img.youtube.com/vi/KQ3UdwH-9MU/maxresdefault.jpg');">
                    <div class="absolute inset-0 bg-gradient-to-t from-galaxy-950/90 via-galaxy-950/40 to-transparent"></div>
                    
                    <!-- Pulsing Play Button -->
                    <div class="relative z-10 w-16 h-16 sm:w-20 sm:h-20 rounded-full btn-galaxy flex items-center justify-center text-white text-2xl sm:text-3xl shadow-2xl group-hover:scale-110 transition-transform duration-300 border border-fuchsia-300/50">
                        <i class="fa-solid fa-play pr-1"></i>
                    </div>
                    <span class="relative z-10 mt-3 text-xs sm:text-sm font-bold text-fuchsia-200 bg-galaxy-950/80 px-4 py-1.5 rounded-full border border-fuchsia-500/40 backdrop-blur-md">
                        לחצו לצפייה בסרטון המלא 🎬
                    </span>
                </div>

                <iframe 
                    id="youtubeIframe"
                    class="w-full h-full absolute inset-0 border-0" 
                    src="https://www.youtube.com/embed/KQ3UdwH-9MU?rel=0&enablejsapi=1" 
                    title="4 צעדים להתגבר על ביישנות ולבנות ביטחון עצמי" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                    allowfullscreen>
                </iframe>
            </div>

            <script>
                function playVideoAction() {
                    var cover = document.getElementById('videoCover');
                    var iframe = document.getElementById('youtubeIframe');
                    
                    if (cover) {
                        cover.style.display = 'none';
                    }

                    // Check if running inside editor preview iFrame
                    var isPreviewFrame = !window.location.origin || window.location.origin === 'null' || window.location.protocol === 'file:';

                    if (isPreviewFrame) {
                        // Open in smooth pop-up/tab if inside editor preview to bypass Error 153 sandbox restriction
                        window.open("https://www.youtube.com/watch?v=KQ3UdwH-9MU", "_blank");
                    } else if (iframe) {
                        iframe.src = "https://www.youtube.com/embed/KQ3UdwH-9MU?autoplay=1&rel=0";
                    }
                }
            </script>

            <!-- MAIN CTA BUTTON DIRECTLY UNDER VIDEO -->
            <div class="pt-2 text-center">
                <a href="https://madlenfrid.netlify.app/?utm_source=ig&utm_medium=social&utm_content=link_in_bio&fbclid=PAcGRvZgJleHRuA2FlbQIxMQBzcnRjBmFwcF9pZA85MzY2MTk3NDMzOTI0NTkAAafY_3Y70d4WjTZ58HT14AASER6gRiK_NJV6m7gA4snWwzgqtqFq1Nf8jgfl4A_aem_CtiVAXucga8rebyeWsnQxQ" id="mainCtaLink" target="_blank" rel="noopener noreferrer" 
                    class="inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-6 sm:px-8 py-3.5 sm:py-4 btn-galaxy text-white font-heading font-extrabold text-sm sm:text-lg rounded-xl sm:rounded-2xl border border-fuchsia-300/30 cursor-pointer">
